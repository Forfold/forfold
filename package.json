    "@mui/material": "7.3.4",
    "@types/gapi": "0.0.47",
    "@types/gapi.auth2": "0.0.61",
    "@types/gapi.client.drive": "3.0.15",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-json-pretty": "2.2.0",
    "react-router-dom": "7.9.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
